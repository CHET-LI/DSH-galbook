{
  "name": "galbook",
  "version": "1.2.3",
  "type": "module",
  "description": "Let an AI agent play galgames/visual novels by itself: read line by line, choose on its own with a written reason, save/load/rewind. Ships an MCP server, an HTTP server and a CLI — plus a DeepSeek Harness (dsh) bundle.",
  "license": "MIT",
  "author": "CHET-LI",
  "homepage": "https://github.com/CHET-LI/DSH-galbook",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CHET-LI/DSH-galbook.git"
  },
  "bugs": {
    "url": "https://github.com/CHET-LI/DSH-galbook/issues"
  },
  "keywords": [
    "galgame",
    "visual-novel",
    "mcp",
    "mcp-server",
    "ai-agent",
    "llm",
    "dsh-plugin",
    "deepseek-harness",
    "text-adventure",
    "galbook"
  ],
  "icon": "./icon.svg",
  "exports": {
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "galbook/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "dsh-plugin/**",
    ".agents/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}