{
  "name": "galbook",
  "version": "1.2.4",
  "type": "module",
  "description": "Play a galgame / visual novel like a human would: read one line at a time, pick choices yourself and write down why, save, load, rewind to the last choice. Ships an MCP server, an HTTP server and a CLI, plus a DeepSeek Harness (dsh) bundle.",
  "license": "MIT",
  "author": "CHET-LI",
  "homepage": "https://github.com/CHET-LI/DSH-galbook",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CHET-LI/DSH-galbook.git"
  },
  "bugs": {
    "url": "https://github.com/CHET-LI/DSH-galbook/issues"
  },
  "keywords": [
    "galgame",
    "visual-novel",
    "mcp",
    "mcp-server",
    "ai-agent",
    "llm",
    "dsh-plugin",
    "deepseek-harness",
    "text-adventure",
    "galbook"
  ],
  "icon": "./icon.svg",
  "bin": {
    "galbook": "bin/galbook.js"
  },
  "exports": {
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "bin/**",
    "galbook/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "dsh-plugin/**",
    ".agents/**",
    "!**/__pycache__/**",
    "!**/*.pyc"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
